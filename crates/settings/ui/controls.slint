// Controls of the Windows 11 Settings look (CommunityToolkit SettingsCard / SettingsExpander, InfoBar, a
// ToggleSwitch with its On/Off label) and the app's own ones (traffic lights, island preview, shortcut box).

import { Button, Switch, ScrollView } from "std-widgets.slint";
import { L, Theme } from "theme.slint";

// A Segoe Fluent Icons glyph.
export component Glyph inherits Text {
    font-family: Theme.icon-font;
    font-size: 16px;
    color: Theme.text-primary;
    horizontal-alignment: center;
    vertical-alignment: center;
    accessible-role: none;
}

// Page header ("General"), as TitleTextBlockStyle with the page margins.
export component PageTitle inherits VerticalLayout {
    in property <string> text;
    in property <length> bottom: 16px;
    padding-top: 28px;
    padding-bottom: root.bottom;
    Text {
        text: root.text;
        font-size: Theme.title;
        font-weight: 600;
        color: Theme.text-primary;
        accessible-role: none;
    }
}

// Section header ("Behavior"): BodyStrong with a gap above.
export component SectionHeader inherits VerticalLayout {
    in property <string> text;
    padding-top: 20px;
    padding-bottom: 2px;
    padding-left: 1px;
    Text {
        text: root.text;
        font-size: Theme.body;
        font-weight: 600;
        color: Theme.text-primary;
        accessible-role: none;
    }
}

// Secondary text that wraps ("Extra things the island can show…").
export component Note inherits Text {
    wrap: word-wrap;
    font-size: Theme.body;
    color: Theme.text-secondary;
}

// A settings page: scrolls, at most 1000 wide and centered, with the page title on top.
export component Page inherits Rectangle {
    in property <string> title;
    in property <length> title-bottom: 16px;
    sv := ScrollView {
        content-layout := VerticalLayout {
            width: sv.visible-width;
            alignment: start;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    max-width: 1000px;
                    horizontal-stretch: 1;
                    padding-left: 36px;
                    padding-right: 36px;
                    padding-bottom: 36px;
                    spacing: 4px;
                    PageTitle {
                        text: root.title;
                        bottom: root.title-bottom;
                    }
                    @children
                }
            }
        }
    }
}

// The header part of a card: icon, header and description (and the add-ons' status line).
export component CardHeader inherits HorizontalLayout {
    in property <string> glyph;
    in property <image> image;
    in property <string> header;
    in property <string> description;
    in property <string> status;
    in property <bool> status-problem;
    in property <bool> enabled: true;
    spacing: 0px;
    if root.glyph != "": HorizontalLayout {
        padding-left: 2px;
        padding-right: 20px;
        Glyph {
            text: root.glyph;
            font-size: 20px;
            width: 20px;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        }
    }
    if root.image.width > 0: HorizontalLayout {
        padding-left: 2px;
        padding-right: 20px;
        alignment: center;
        Image {
            source: root.image;
            width: 20px;
            height: 20px;
            accessible-role: none;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 1px;
        Text {
            text: root.header;
            wrap: word-wrap;
            font-size: Theme.body;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        }
        if root.description != "": Text {
            text: root.description;
            wrap: word-wrap;
            font-size: Theme.caption;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
        }
        if root.status != "": VerticalLayout {
            padding-top: 4px;
            Text {
                text: root.status;
                wrap: word-wrap;
                font-size: Theme.caption;
                color: root.status-problem ? Theme.caution : Theme.text-tertiary;
            }
        }
    }
}

// SettingsCard: header on the left, the control (children) on the right.
export component SettingsCard inherits Rectangle {
    in property <string> glyph;
    in property <image> image;
    in property <string> header;
    in property <string> description;
    in property <string> status;
    in property <bool> status-problem;
    in property <bool> enabled: true;
    // IsClickEnabled: the whole card is a button, with the action icon at the right.
    in property <bool> clickable;
    in property <string> action-glyph: "\u{E8A7}";
    callback clicked;

    min-height: 68px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.card-stroke;
    background: !root.clickable || !root.enabled ? Theme.card : touch.pressed ? Theme.card-pressed : touch.has-hover ? Theme.card-hover : Theme.card;
    accessible-role: groupbox;
    accessible-label: root.header;
    accessible-description: root.description;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        enabled: root.clickable && root.enabled;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        CardHeader {
            glyph: root.glyph;
            image: root.image;
            header: root.header;
            description: root.description;
            status: root.status;
            status-problem: root.status-problem;
            enabled: root.enabled;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            @children
        }
        if root.clickable: Glyph {
            text: root.action-glyph;
            font-size: 13px;
            width: 16px;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        }
    }
}

// SettingsCard with ContentAlignment="Vertical": the control (children) stretched below the header.
export component SettingsCardVertical inherits Rectangle {
    in property <string> glyph;
    in property <string> header;
    in property <string> description;
    in property <bool> enabled: true;
    min-height: max(68px, inner.min-height);
    preferred-height: inner.preferred-height;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.card-stroke;
    background: Theme.card;
    inner := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 16px;
        spacing: 12px;
        CardHeader {
            glyph: root.glyph;
            header: root.header;
            description: root.description;
            enabled: root.enabled;
        }
        @children
    }
}

// An item inside an open SettingsExpander: aligned with the header text, with a line above.
export component ExpanderItem inherits Rectangle {
    in property <string> header;
    in property <string> description;
    in property <bool> enabled: true;
    min-height: 52px;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.divider;
    }
    HorizontalLayout {
        padding-left: 58px;
        padding-right: 44px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 16px;
        CardHeader {
            header: root.header;
            description: root.description;
            enabled: root.enabled;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            @children
        }
    }
}

// An expander item whose content goes below its header (calendar links, quiet times, API examples).
export component ExpanderItemVertical inherits Rectangle {
    in property <string> header;
    in property <string> description;
    in property <bool> enabled: true;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.divider;
    }
    VerticalLayout {
        padding-left: 58px;
        padding-right: 44px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 10px;
        if root.header != "" || root.description != "": CardHeader {
            header: root.header;
            description: root.description;
            enabled: root.enabled;
        }
        @children
    }
}

// The WinUI ToggleSwitch as SettingsCard shows it: "On"/"Off" left of the switch.
export component ToggleSwitch inherits HorizontalLayout {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);
    spacing: 12px;
    alignment: end;
    Text {
        text: root.checked ? L.t("On") : L.t("Off");
        vertical-alignment: center;
        font-size: Theme.body;
        color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        accessible-role: none;
    }
    Switch {
        checked <=> root.checked;
        enabled: root.enabled;
        accessible-label: root.label;
        toggled => { root.toggled(self.checked); }
    }
}

// A button that shows a glyph (remove, close), subtle unless `bordered`.
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <length> glyph-size: 14px;
    in property <bool> bordered: true;
    in property <bool> enabled: true;
    in property <string> tooltip;
    callback clicked;
    width: 34px;
    height: 32px;
    border-radius: 4px;
    border-width: root.bordered ? 1px : 0px;
    border-color: Theme.control-stroke;
    background: !root.enabled ? transparent : touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.subtle-hover : (root.bordered ? Theme.control : transparent);
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Glyph {
        text: root.glyph;
        font-size: root.glyph-size;
        color: root.enabled ? Theme.text-primary : Theme.text-disabled;
    }
    if root.tooltip != "": Tooltip {
        text: @markdown("\{root.tooltip}");
    }
}

// HyperlinkButton: accent-colored text.
export component LinkButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 32px;
    width: label.preferred-width + 22px;
    border-radius: 4px;
    background: touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.subtle-hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        font-size: Theme.body;
        color: touch.pressed ? Theme.accent-text.with-alpha(0.5) : touch.has-hover ? Theme.accent-text.with-alpha(0.8) : Theme.accent-text;
        vertical-alignment: center;
        horizontal-alignment: center;
        accessible-role: none;
    }
}

export enum Severity { informational, success, warning, error }

// InfoBar: a colored bar with an icon, title, message, an optional action button and close button.
export component InfoBar inherits Rectangle {
    in property <Severity> severity: Severity.informational;
    in property <string> title;
    in property <string> message;
    in property <string> action;
    in property <bool> closable;
    callback action-clicked;
    callback closed;

    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.card-stroke;
    background: root.severity == Severity.warning ? Theme.warning-background
        : root.severity == Severity.error ? Theme.error-background
        : root.severity == Severity.success ? Theme.success-background
        : Theme.info-background;
    accessible-role: groupbox;
    accessible-label: root.title;
    accessible-description: root.message;

    property <color> icon-color: root.severity == Severity.warning ? Theme.caution
        : root.severity == Severity.error ? Theme.error
        : root.severity == Severity.success ? Theme.success
        : Theme.accent-text;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 16px;
        VerticalLayout {
            padding-top: 15px;
            alignment: start;
            Rectangle {
                width: 16px;
                height: 16px;
                Glyph {
                    text: "\u{F136}";
                    color: root.icon-color;
                }
                Glyph {
                    text: root.severity == Severity.warning ? "\u{F13C}" : root.severity == Severity.error ? "\u{F13D}" : root.severity == Severity.success ? "\u{F13E}" : "\u{F13F}";
                    color: Theme.dark ? #000000 : #ffffff;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 13px;
            padding-bottom: 13px;
            spacing: 4px;
            if root.title != "": Text {
                text: root.title;
                wrap: word-wrap;
                font-size: Theme.body;
                font-weight: 600;
                color: Theme.text-primary;
            }
            if root.message != "": Text {
                text: root.message;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-primary;
            }
            @children
        }
        if root.action != "": VerticalLayout {
            padding-top: 8px;
            alignment: start;
            Button {
                text: root.action;
                clicked => { root.action-clicked(); }
            }
        }
        if root.closable: VerticalLayout {
            padding-top: 8px;
            alignment: start;
            IconButton {
                glyph: "\u{E711}";
                glyph-size: 12px;
                bordered: false;
                width: 32px;
                tooltip: L.t("Close");
                clicked => { root.closed(); }
            }
        }
    }
}

// The red / yellow / green window buttons from macOS. Glyphs show while the pointer is over the group, and
// like macOS they turn grey while the window is in the background (unless hovered).
export component TrafficLights inherits HorizontalLayout {
    in property <bool> active: true;
    callback close();
    callback minimize();
    callback zoom();

    property <bool> hovering: close-area.has-hover || minimize-area.has-hover || zoom-area.has-hover;
    property <bool> colored: root.active || root.hovering;
    property <color> grey-fill: Theme.dark ? #4a4a4a : #dddddd;
    property <color> grey-edge: Theme.dark ? #3a3a3a : #c8c8c8;
    spacing: 0px;

    Rectangle {
        width: 16px;
        height: 20px;
        accessible-role: button;
        accessible-label: L.t("Close");
        accessible-action-default => { root.close(); }
        close-area := TouchArea {
            clicked => { root.close(); }
        }
        Rectangle {
            x: 0px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            border-width: 0.5px;
            background: root.colored ? #ff5f57 : root.grey-fill;
            border-color: root.colored ? #e0443e : root.grey-edge;
            opacity: close-area.pressed ? 0.75 : 1;
            Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M3.6,3.6 L8.4,8.4 M8.4,3.6 L3.6,8.4";
                stroke: #4d0000;
                stroke-width: 1.2px;
                stroke-line-cap: round;
                opacity: root.hovering ? 1 : 0;
            }
        }
    }
    Rectangle {
        width: 20px;
        height: 20px;
        accessible-role: button;
        accessible-label: L.t("Minimize");
        accessible-action-default => { root.minimize(); }
        minimize-area := TouchArea {
            clicked => { root.minimize(); }
        }
        Rectangle {
            x: 4px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            border-width: 0.5px;
            background: root.colored ? #febc2e : root.grey-fill;
            border-color: root.colored ? #dea123 : root.grey-edge;
            opacity: minimize-area.pressed ? 0.75 : 1;
            Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M3,6 L9,6";
                stroke: #985700;
                stroke-width: 1.3px;
                stroke-line-cap: round;
                opacity: root.hovering ? 1 : 0;
            }
        }
    }
    Rectangle {
        width: 20px;
        height: 20px;
        accessible-role: button;
        accessible-label: L.t("Maximize");
        accessible-action-default => { root.zoom(); }
        zoom-area := TouchArea {
            clicked => { root.zoom(); }
        }
        Rectangle {
            x: 4px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            border-width: 0.5px;
            background: root.colored ? #28c840 : root.grey-fill;
            border-color: root.colored ? #1aab29 : root.grey-edge;
            opacity: zoom-area.pressed ? 0.75 : 1;
            Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M3.4,3.4 L7.3,3.4 L3.4,7.3 Z M8.6,8.6 L4.7,8.6 L8.6,4.7 Z";
                fill: #006500;
                opacity: root.hovering ? 1 : 0;
            }
        }
    }
}

// A drawing of the top of a screen with the island on it (playing music), at its real size, distance from the
// top and colors. Used on the General page and in the welcome tour. 230 × 37: Apple's compact island.
export component IslandPreview inherits Rectangle {
    in property <float> scale: 1;
    in property <float> offset: 8;
    in property <bool> light;
    height: 132px;
    border-radius: 8px;
    clip: true;
    background: @linear-gradient(135deg, #5b7ce8 0%, #b58ce0 100%);
    accessible-role: image;
    accessible-label: L.t("Preview of the island");

    pill := Rectangle {
        width: 230px * root.scale;
        height: 37px * root.scale;
        x: (parent.width - self.width) / 2;
        y: root.offset * 1px * root.scale;
        border-radius: self.height / 2;
        background: root.light ? #f5f5f7 : #000000;
        // The hairline key line, as on the island: grey on the light one, faint white on the black one.
        border-width: 1px;
        border-color: root.light ? #00000022 : #ffffff24;
        // Same insets as the real island's compact view.
        Rectangle {
            x: 10px * root.scale;
            width: 24px * root.scale;
            height: 24px * root.scale;
            border-radius: 6px;
            background: @linear-gradient(135deg, #ff7a59 0%, #c93f8e 100%);
        }
        HorizontalLayout {
            x: parent.width - self.width - 12px * root.scale;
            width: self.preferred-width;
            spacing: 2.5px * root.scale;
            for level in [0.45, 0.8, 0.6, 1.0, 0.55]: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 3px * root.scale;
                    height: 16px * root.scale * level;
                    border-radius: 1.5px * root.scale;
                    background: #30d158;
                }
            }
        }
    }
}

// Records a global shortcut: click, press a key combination, done. Esc cancels; Clear turns the shortcut off.
// The keys are caught by a keyboard hook in Rust (see shortcut.rs).
export component ShortcutBox inherits HorizontalLayout {
    in property <string> text;
    in property <bool> recording;
    in property <bool> can-clear;
    in property <string> label;
    callback record();
    callback clear();
    callback stop();
    property <string> tip: L.t("Click, then press the keys you want");
    spacing: 8px;
    alignment: end;
    record-button := Button {
        min-width: 150px;
        text: root.recording ? L.t("Press a shortcut…") : root.text;
        accessible-label: root.label;
        clicked => { root.record(); }
        changed has-focus => {
            if !self.has-focus && root.recording {
                root.stop();
            }
        }
        Tooltip {
            text: @markdown("\{root.tip}");
        }
    }
    Button {
        text: L.t("Clear");
        enabled: root.can-clear && !root.recording;
        clicked => { root.clear(); }
    }
}

// A key cap ("Ctrl") in the welcome tour.
export component KeyCap inherits Rectangle {
    in property <string> text;
    border-radius: 6px;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.control-stroke-bottom;
    width: label.preferred-width + 20px;
    height: label.preferred-height + 10px;
    label := Text {
        text: root.text;
        font-weight: 600;
        font-size: Theme.body;
        color: Theme.text-primary;
    }
}

// TimePicker (24-hour clock, 5-minute steps): "22 : 00", opening two columns to pick from.
export component TimeField inherits Rectangle {
    in property <int> hour;
    in property <int> minute;
    in property <bool> enabled: true;
    in property <string> label;
    callback changed(int, int);

    property <int> pick-hour;
    property <int> pick-minute;
    width: 132px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.control-stroke;
    background: !root.enabled ? Theme.subtle-pressed : touch.pressed ? Theme.card-pressed : touch.has-hover ? Theme.card-hover : Theme.control;
    accessible-role: button;
    accessible-label: root.label;
    accessible-value: root.two(root.hour) + ":" + root.two(root.minute);
    accessible-action-default => { root.open(); }

    pure function two(n: int) -> string {
        return (n < 10 ? "0" : "") + n;
    }
    function open() {
        root.pick-hour = root.hour;
        root.pick-minute = Math.round(root.minute / 5) * 5;
        popup.show();
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.open(); }
    }
    HorizontalLayout {
        Text {
            horizontal-stretch: 1;
            text: root.two(root.hour);
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: Theme.body;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        }
        Rectangle {
            width: 1px;
            background: Theme.divider;
        }
        Text {
            horizontal-stretch: 1;
            text: root.two(root.minute);
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: Theme.body;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: 8px;
            background: Theme.dark ? #2c2c2c : #f9f9f9;
            border-width: 1px;
            border-color: Theme.dialog-stroke;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 4px;
                spacing: 4px;
                HorizontalLayout {
                    height: 200px;
                    ScrollView {
                        VerticalLayout {
                            for h in 24: Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                background: h == root.pick-hour ? Theme.accent : hour-touch.has-hover ? Theme.subtle-hover : transparent;
                                hour-touch := TouchArea {
                                    clicked => { root.pick-hour = h; }
                                }
                                Text {
                                    text: root.two(h);
                                    font-size: Theme.body;
                                    color: h == root.pick-hour ? (Theme.dark ? #000000 : #ffffff) : Theme.text-primary;
                                }
                            }
                        }
                    }
                    ScrollView {
                        VerticalLayout {
                            for m in 12: Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                background: m * 5 == root.pick-minute ? Theme.accent : minute-touch.has-hover ? Theme.subtle-hover : transparent;
                                minute-touch := TouchArea {
                                    clicked => { root.pick-minute = m * 5; }
                                }
                                Text {
                                    text: root.two(m * 5);
                                    font-size: Theme.body;
                                    color: m * 5 == root.pick-minute ? (Theme.dark ? #000000 : #ffffff) : Theme.text-primary;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }
                HorizontalLayout {
                    spacing: 4px;
                    IconButton {
                        horizontal-stretch: 1;
                        bordered: false;
                        glyph: "\u{E8FB}";
                        tooltip: L.t("OK");
                        clicked => {
                            root.changed(root.pick-hour, root.pick-minute);
                            popup.close();
                        }
                    }
                    IconButton {
                        horizontal-stretch: 1;
                        bordered: false;
                        glyph: "\u{E711}";
                        tooltip: L.t("Cancel");
                        clicked => { popup.close(); }
                    }
                }
            }
        }
    }
}

// ContentDialog: a smoke layer over the window with the dialog in the middle and its buttons at the bottom.
export component ContentDialog inherits Rectangle {
    in property <string> title;
    in property <string> primary;
    in property <string> secondary;
    in property <string> close;
    in property <length> content-width: 460px;
    callback primary-clicked;
    callback secondary-clicked;
    callback close-clicked;

    background: Theme.smoke;
    // Swallow clicks on the smoke layer, as a modal dialog does.
    TouchArea { }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-clicked();
                return accept;
            }
            reject
        }
    }
    box := Rectangle {
        width: min(root.content-width + 48px, root.width - 32px);
        height: min(self.preferred-height, root.height - 32px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: 8px;
        background: Theme.dialog;
        border-width: 1px;
        border-color: Theme.dialog-stroke;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000042;
        clip: true;
        accessible-role: groupbox;
        accessible-label: root.title;
        VerticalLayout {
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                vertical-stretch: 1;
                Text {
                    text: root.title;
                    wrap: word-wrap;
                    font-size: Theme.subtitle;
                    font-weight: 600;
                    color: Theme.text-primary;
                }
                @children
            }
            Rectangle {
                background: Theme.dialog-footer;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.dialog-stroke;
                }
                HorizontalLayout {
                    padding: 24px;
                    spacing: 8px;
                    // Equal widths, as ContentDialog's buttons.
                    if root.primary != "": Button {
                        preferred-width: 1px;
                        horizontal-stretch: 1;
                        primary: true;
                        text: root.primary;
                        clicked => { root.primary-clicked(); }
                    }
                    if root.secondary != "": Button {
                        preferred-width: 1px;
                        horizontal-stretch: 1;
                        text: root.secondary;
                        clicked => { root.secondary-clicked(); }
                    }
                    if root.close != "": Button {
                        preferred-width: 1px;
                        horizontal-stretch: 1;
                        text: root.close;
                        clicked => { root.close-clicked(); }
                    }
                }
            }
        }
    }
}

// SettingsExpander: a card that opens to show more settings (the children). The header can carry an add-on's
// Preview button and on/off switch.
export component SettingsExpander inherits VerticalLayout {
    in property <string> glyph;
    in property <string> header;
    in property <string> description;
    in property <string> status;
    in property <bool> status-problem;
    in property <bool> enabled: true;
    in-out property <bool> expanded;
    in property <bool> has-switch;
    in-out property <bool> on;
    in property <bool> has-preview;
    callback toggled(bool);
    callback preview();
    callback expanded-changed(bool);
    property <string> preview-tip: L.t("Show a sample in the island");
    spacing: 0px;

    header-card := Rectangle {
        min-height: 68px;
        border-top-left-radius: 4px;
        border-top-right-radius: 4px;
        border-bottom-left-radius: root.expanded ? 0px : 4px;
        border-bottom-right-radius: root.expanded ? 0px : 4px;
        border-width: 1px;
        border-color: Theme.card-stroke;
        background: touch.pressed ? Theme.card-pressed : touch.has-hover ? Theme.card-hover : Theme.card;
        accessible-role: button;
        accessible-label: root.header;
        accessible-description: root.description;
        accessible-expandable: true;
        accessible-expanded: root.expanded;
        accessible-action-expand => { root.flip(); }
        accessible-action-default => { root.flip(); }

        touch := TouchArea {
            clicked => { root.flip(); }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 8px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 16px;
            CardHeader {
                glyph: root.glyph;
                header: root.header;
                description: root.description;
                status: root.status;
                status-problem: root.status-problem;
                enabled: root.enabled;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 12px;
                if root.has-preview: VerticalLayout {
                    alignment: center;
                    Button {
                        text: L.t("Preview");
                        enabled: root.enabled;
                        clicked => { root.preview(); }
                        Tooltip {
                            text: @markdown("\{root.preview-tip}");
                        }
                    }
                }
                if root.has-switch: ToggleSwitch {
                    checked <=> root.on;
                    enabled: root.enabled;
                    label: root.header;
                    toggled(value) => { root.toggled(value); }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        glyph: root.expanded ? "\u{E70E}" : "\u{E70D}";
                        glyph-size: 12px;
                        bordered: false;
                        width: 32px;
                        clicked => { root.flip(); }
                    }
                }
            }
        }
    }
    Rectangle {
        visible: root.expanded;
        height: root.expanded ? self.preferred-height : 0px;
        border-bottom-left-radius: 4px;
        border-bottom-right-radius: 4px;
        border-width: 1px;
        border-color: Theme.card-stroke;
        background: Theme.card-secondary;
        VerticalLayout {
            padding-top: -1px;
            @children
        }
    }

    function flip() {
        root.expanded = !root.expanded;
        root.expanded-changed(root.expanded);
    }
}
